# Secrets for scripts/preview.sh, as 1Password references `op run` resolves.
# No values here. Same vault and item convention as secrets.env (Password items
# named after the env var, field `password`). The bucket items are read-only
# copies of the Railway bucket credentials (Bucket → Credentials): Litestream
# restores a fresh copy of the live database, the corpus reader serves page
# HTML to extract-recipe. `op run` fails if an item is missing, so comment out
# a line whose item you have not created.
DEEPSEEK_API_KEY=op://spiritolo-prod/DEEPSEEK_API_KEY/password
# ANTHROPIC_API_KEY=op://spiritolo-prod/ANTHROPIC_API_KEY/password
# OPENAI_API_KEY=op://spiritolo-prod/OPENAI_API_KEY/password
LITESTREAM_BUCKET=op://spiritolo-prod/LITESTREAM_BUCKET/password
LITESTREAM_ENDPOINT=op://spiritolo-prod/LITESTREAM_ENDPOINT/password
LITESTREAM_ACCESS_KEY_ID=op://spiritolo-prod/LITESTREAM_ACCESS_KEY_ID/password
LITESTREAM_SECRET_ACCESS_KEY=op://spiritolo-prod/LITESTREAM_SECRET_ACCESS_KEY/password
CORPUS_BUCKET=op://spiritolo-prod/CORPUS_BUCKET/password
CORPUS_ENDPOINT=op://spiritolo-prod/CORPUS_ENDPOINT/password
CORPUS_ACCESS_KEY_ID=op://spiritolo-prod/CORPUS_ACCESS_KEY_ID/password
CORPUS_SECRET_ACCESS_KEY=op://spiritolo-prod/CORPUS_SECRET_ACCESS_KEY/password
