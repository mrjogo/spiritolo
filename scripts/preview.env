# Secrets for scripts/preview.sh: only the LLM keys. No database or bucket
# credentials: the preview runs on a local snapshot (scripts/fetch-snapshot.sh)
# and reads page HTML from the scraper's local cache.
#
# 1Password references `op run` resolves; no values here. Same vault and item
# convention as secrets.env. `op run` fails if an item is missing, so comment
# out a line whose item you have not created. To skip 1Password, point
# PREVIEW_ENV_FILE at a private file (chmod 600) of plain KEY=value lines.
DEEPSEEK_API_KEY=op://spiritolo-prod/DEEPSEEK_API_KEY/password
# ANTHROPIC_API_KEY=op://spiritolo-prod/ANTHROPIC_API_KEY/password
# OPENAI_API_KEY=op://spiritolo-prod/OPENAI_API_KEY/password
