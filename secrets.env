# Runtime secrets, as 1Password references resolved by `op run` at boot.
# This file holds NO secret values — only op://<vault>/<item>/<field> pointers.
# Ruddick owns the vault; the service's only sealed Railway variable is
# OP_SERVICE_ACCOUNT_TOKEN, which lets `op run` read these items.
#
# Vault / item names below are the spec defaults; adjust to the real ones.
SESSION_SECRET=op://spiritolo/app/session-secret
ANTHROPIC_API_KEY=op://spiritolo/llm/anthropic-api-key
OPENAI_API_KEY=op://spiritolo/llm/openai-api-key
DEEPSEEK_API_KEY=op://spiritolo/llm/deepseek-api-key
LITESTREAM_ACCESS_KEY_ID=op://spiritolo/litestream-bucket/access-key-id
LITESTREAM_SECRET_ACCESS_KEY=op://spiritolo/litestream-bucket/secret-access-key
# The HTML corpus bucket (page HTML the extract stage reads), via the AWS_*
# names ingredients/pipeline/corpus.py expects. The non-secret half
# (AWS_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_DEFAULT_REGION, AWS_S3_URL_STYLE)
# is set as plain Railway variables.
AWS_ACCESS_KEY_ID=op://spiritolo/corpus-bucket/access-key-id
AWS_SECRET_ACCESS_KEY=op://spiritolo/corpus-bucket/secret-access-key
